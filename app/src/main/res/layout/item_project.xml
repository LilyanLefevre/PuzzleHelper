<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/puzzle_surface"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/puzzle_primary_container"
    app:strokeColor="@color/puzzle_outline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageViewThumbnail"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@color/puzzle_surface_high"
            android:contentDescription="@string/project_thumbnail"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:shapeAppearanceOverlay="@style/Shape.Puzzle.Medium"
            tools:src="@android:drawable/ic_menu_camera" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textViewProjectName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/puzzle_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageViewThumbnail"
            app:layout_constraintTop_toTopOf="@id/imageViewThumbnail"
            tools:text="La vague" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textNumberPieces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_accent"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/puzzle_on_primary_container"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/textViewProjectName"
            app:layout_constraintTop_toBottomOf="@id/textViewProjectName"
            tools:text="1000 pièces" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textViewCreationDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/puzzle_on_surface_variant"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textViewProjectName"
            app:layout_constraintTop_toBottomOf="@id/textNumberPieces"
            tools:text="mer. 07 oct. 2026" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
