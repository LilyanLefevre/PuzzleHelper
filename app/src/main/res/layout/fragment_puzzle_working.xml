<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/puzzle_background"
    tools:context=".feature.puzzle.PuzzleWorkingFragment">

    <com.lilyan_lefevre.puzzleit.feature.puzzle.PuzzleMapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/puzzle_reference_image" />

    <!-- Floating top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBack"
            style="@style/Widget.Puzzle.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp" />

        <LinearLayout
            android:id="@+id/titleCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_title_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/textViewProjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/puzzle_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="La vague" />

            <TextView
                android:id="@+id/textViewProjectInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/puzzle_on_surface_variant"
                android:textSize="12sp"
                tools:text="1000 pièces · grille 40 × 25" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEdit"
            style="@style/Widget.Puzzle.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/edit_button"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDelete"
            style="@style/Widget.Puzzle.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/delete_button"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp" />
    </LinearLayout>

    <com.lilyan_lefevre.puzzleit.core.ui.PuzzleLoaderView
        android:id="@+id/progressBar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Bottom sheet. Result state: dragged between peek (the leads), half (comparison), full (why these leads) and hidden;
         idle, analysing and error states are fixed. -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        app:behavior_expandedOffset="72dp"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.55"
        app:behavior_hideable="true"
        app:behavior_peekHeight="160dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_grabber" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/sheetScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/sheetContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="28dp">

        <!-- IDLE -->
        <LinearLayout
            android:id="@+id/groupIdle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_hint_title"
                android:textAppearance="@style/Text.Display"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/scan_hint_body"
                android:textColor="@color/puzzle_on_surface_variant"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCapturePiece"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:text="@string/scan_piece"
                android:textColor="@color/puzzle_on_primary"
                android:textSize="17sp"
                app:backgroundTint="@color/puzzle_primary"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_scan"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="@color/puzzle_on_primary" />
        </LinearLayout>

        <!-- ANALYZING -->
        <LinearLayout
            android:id="@+id/groupAnalyzing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <com.lilyan_lefevre.puzzleit.core.ui.PuzzleLoaderView
                android:layout_width="64dp"
                android:layout_height="64dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analyzing"
                    android:textAppearance="@style/Text.Display"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/analyzing_sub"
                    android:textColor="@color/puzzle_on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- RESULT -->
        <LinearLayout
            android:id="@+id/groupResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:id="@+id/chipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipLeads"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/textLead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/best_lead"
                android:textAppearance="@style/Text.Eyebrow" />

            <TextView
                android:id="@+id/textSpot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Text.Display"
                android:textSize="26sp"
                tools:text="En haut à gauche" />

            <TextView
                android:id="@+id/textSpotDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/puzzle_on_surface_variant"
                android:textSize="14sp"
                tools:text="à 24 % depuis la gauche · 12 % depuis le haut" />

            <!-- Compare: the piece, turned the right way, next to the box at this lead -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:background="@drawable/bg_compare_tile">

                        <ImageView
                            android:id="@+id/imagePiece"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_gravity="center"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/your_piece"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/your_piece"
                        android:textColor="@color/puzzle_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginBottom="18dp"
                    android:text="≈"
                    android:textColor="@color/puzzle_on_surface_variant"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imageBoxPatch"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:background="@drawable/bg_compare_tile"
                        android:contentDescription="@string/on_the_box"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/Shape.Puzzle.Small"
                        app:strokeColor="@color/puzzle_primary"
                        app:strokeWidth="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/on_the_box"
                        android:textColor="@color/puzzle_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textRotate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginBottom="18dp"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:textColor="@color/puzzle_secondary_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableTopCompat="@drawable/ic_rotate_small"
                    tools:text="Tourne-la de 90° vers la droite" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textConfLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/puzzle_on_surface_variant"
                    android:textSize="14sp"
                    tools:text="Confiance · Correspondance forte" />

                <TextView
                    android:id="@+id/textConfValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/puzzle_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="82 %" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/confBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                app:indicatorColor="@color/puzzle_primary"
                app:trackColor="@color/puzzle_surface_high"
                app:trackCornerRadius="6dp"
                app:trackThickness="8dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonNewPiece"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/new_piece"
                    android:textColor="@color/puzzle_on_primary"
                    app:backgroundTint="@color/puzzle_primary"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_scan"
                    app:iconGravity="textStart"
                    app:iconTint="@color/puzzle_on_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDismiss"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:text="@string/dismiss"
                    android:textColor="@color/puzzle_on_surface"
                    app:backgroundTint="@color/puzzle_surface_high"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- WHY THESE LEADS (full level) -->
            <LinearLayout
                android:id="@+id/groupExplain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/explain_title"
                    android:textAppearance="@style/Text.Display"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/explain_intro"
                    android:textColor="@color/puzzle_on_surface_variant"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/explainList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- ERROR (blurry / no piece) -->
        <LinearLayout
            android:id="@+id/groupError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Display"
                android:textColor="@color/puzzle_warning"
                android:textSize="24sp"
                tools:text="Photo trop floue" />

            <TextView
                android:id="@+id/textErrorBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/puzzle_on_surface_variant"
                android:textSize="15sp"
                tools:text="Reste stable…" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRetake"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/retake"
                    android:textColor="@color/puzzle_on_primary"
                    app:backgroundTint="@color/puzzle_primary"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_scan"
                    app:iconGravity="textStart"
                    app:iconTint="@color/puzzle_on_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonErrorDismiss"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:text="@string/dismiss"
                    android:textColor="@color/puzzle_on_surface"
                    app:backgroundTint="@color/puzzle_surface_high"
                    app:cornerRadius="18dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Back to the leads after the sheet was swiped away to move around the puzzle -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/pillLeads"
        style="@style/Widget.Puzzle.Button"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:text="@string/show_leads"
        android:visibility="gone"
        app:icon="@drawable/ic_bolt"
        app:iconGravity="textStart" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
