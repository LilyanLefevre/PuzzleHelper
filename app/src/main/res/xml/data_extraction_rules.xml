<?xml version="1.0" encoding="utf-8"?>
<!-- The account (server token, encrypted with a Keystore key) must never reach a cloud backup or another phone: the key would not follow it anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account_secure.xml" />
    </device-transfer>
</data-extraction-rules>
